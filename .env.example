# ─────────────────────────────────────────────────────────────────────────────
# Ghost AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────────

# Bot token from @BotFather — required for the Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID of the group/channel where new-task alerts are pushed
# Get it by adding @userinfobot to your group and running /start
TELEGRAM_NOTIFY_CHAT_ID=-1001234567890

# URL of the Telegram Mini App (TMA) linked in /start
TMA_URL=https://your-ghost-ai-app.replit.app

# ── AI / Quality Control ──────────────────────────────────────────────────────

# Google Gemini API key — used for proof quality verification
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (Supabase) ───────────────────────────────────────────────────────

# Your Supabase project URL
# Found at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to use in server-side code with RLS)
# Found at: Supabase Dashboard → Settings → API → Project API Keys → anon public
SUPABASE_ANON_KEYS=your_supabase_anon_key_here

# Supabase service role key — ONLY for privileged server operations (bypasses RLS)
# Found at: Supabase Dashboard → Settings → API → Project API Keys → service_role
# WARNING: Keep this private — never expose to frontend or public repositories
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Solana / Blockchain ───────────────────────────────────────────────────────

# Helius RPC URL — enhanced Solana RPC with transaction parsing
# Sign up at: https://helius.dev
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Server wallet private key (base58) — used to sign escrow release transactions
# Generate: solana-keygen new --outfile server-wallet.json
# CRITICAL: Keep this secret — controls protocol treasury
SOLANA_SERVER_WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Ghost AI Protocol ─────────────────────────────────────────────────────────

# Server port (default: 3001)
SERVER_PORT=3001

# Ghost API base URL — used by the SDK and Telegram bot
GHOST_API_URL=http://localhost:3001

# Session secret for express-session (if added later)
SESSION_SECRET=replace_with_32_random_chars

# ── DeFi Integrations (optional — for Kamino/Lulo yield routing) ─────────────

# Kamino Finance program ID (Solana mainnet)
KAMINO_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrVAuEzS2mAAMoHFDF

# Lulo program ID (Solana mainnet)
LULO_PROGRAM_ID=LuLo4NBRdVjnXVMD9u5GSRKtYfYbNfqoqQiE7M17cLZ
